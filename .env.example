# MongoDB Atlas connection string (replica set; transactions are required).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name. Tests use MONGODB_DB_TEST.
MONGODB_DB=pacwoods
MONGODB_DB_TEST=pacwoods_test

# Auth.js signing secret. Generate with: npx auth secret
AUTH_SECRET=

# Calling code for local phone numbers that start with 0, digits only (e.g. 234).
# Leave empty to accept only international (+...) numbers.
DEFAULT_CALLING_CODE=

# Production outside Vercel: the public URL of the app, e.g. https://app.pacwoods.com.
# (On Vercel this is detected automatically. AUTH_TRUST_HOST=true is the
# alternative when a trusted reverse proxy sets the Host header.)
AUTH_URL=

# Photo storage (production). Cloudinary dashboard > API Keys > "API environment variable".
# Photos are stored as private (authenticated) images. Leave empty to keep
# photos in the MongoDB database instead (fine for development).
CLOUDINARY_URL=
